# ==================== VK SERVER CONFIGURATION ====================
# Reality Obfuscation Entry Point for Double Tunnel (89.208.86.167)

# ==================== 3XUI PANEL CONFIGURATION ====================
# VK Server Xray Panel credentials
# Используйте 127.0.0.1 для локальной панели на VK сервере

VK_XRAY_HOST=127.0.0.1
VK_XRAY_PORT=54321
VK_XRAY_USERNAME=admin
VK_XRAY_PASSWORD=admin123

# ==================== REALITY PROTOCOL ====================
# АВТОМАТИЧЕСКОЕ ЗАПОЛНЕНИЕ НИЖЕ:
# Запустите скрипт для получения этих значений:
#   cd deploy/vk-server
#   python init_reality_config.py
# 
# Я заполню эти поля за вас!

# Reality Public Key (from VK panel - получится автоматически)
# Generated by 3xui when you create Reality inbound
# ❌ НЕ ТРОГАЙТЕ - будет заполнено скриптом!
REALITY_PUBLIC_KEY=PUBLIC_KEY_FROM_PANEL

# Reality Short ID (from VK panel - получится автоматически)
# ❌ НЕ ТРОГАЙТЕ - будет заполнено скриптом!
REALITY_SHORT_ID=SHORT_ID_FROM_PANEL

# Fingerprint for TLS obfuscation
# Usually 'chrome' for best compatibility
# Also supported: safari, firefox, edge, qq
REALITY_FINGERPRINT=chrome

# SNI for Reality handshake (fake server name)
# This is the server name clients connect to (not actual server)
REALITY_SNI=dl.google.com

# ==================== OUTBOUND CONFIGURATION ====================
# Configure outbound from VK to NL for double tunnel chain

# NL Server details (where traffic exits)
# This is the exit server for double tunnel
NL_SERVER_IP=85.239.56.174
NL_SERVER_PORT=443

# ==================== OPTIONAL ====================
# Enable ACME for auto-generated Reality keypair
ENABLE_ACME=false

# Logging
LOG_LEVEL=info

# ==================== ИНСТРУКЦИИ ПО НАСТРОЙКЕ ====================
#
# ПЕРВЫЙ ЗАПУСК:
# ===============
# 1. Убедитесь что 3xui запущена на VK сервере
# 2. Откройте .env в этой папке
# 3. Заполните VK_XRAY_USERNAME и VK_XRAY_PASSWORD (логин админа 3xui)
# 4. Запустите скрипт автоматической конфигурации:
#    python init_reality_config.py
# 5. Скрипт автоматически заполнит REALITY_PUBLIC_KEY и REALITY_SHORT_ID
#
# РЕЗУЛЬТАТ:
# ==========
# После запуска скрипта в этом файле будут заполнены:
# ✅ REALITY_PUBLIC_KEY=abc123xyz...
# ✅ REALITY_SHORT_ID=shortID
# ✅ REALITY_FINGERPRINT=chrome
# ✅ REALITY_SNI=dl.google.com
#
# ДЛЯ РУЧНОЙ НАСТРОЙКИ (если скрипт не сработал):
# ================================================
# 1. Откройте 3xui панель: http://89.208.86.167:54321
# 2. Логин/пароль из VK_XRAY_USERNAME и VK_XRAY_PASSWORD выше
# 3. Выберите Inbound -> найдите VLESS с Reality
# 4. В меню Security выберите Reality
# 5. Скопируйте Public Key в REALITY_PUBLIC_KEY выше
# 6. Скопируйте Short ID в REALITY_SHORT_ID выше
#
# ПРОВЕРКА:
# =========
# curl -I http://89.208.86.167:54321/api/inbounds
# Должно вернуть 200 OK если 3xui работает
