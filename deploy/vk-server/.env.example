# ==================== VK SERVER CONFIGURATION ====================
# Reality Obfuscation Entry Point for Double Tunnel

# ==================== 3XUI PANEL CONFIGURATION ====================
# VK Server Xray Panel credentials
# Use 127.0.0.1 for local panel inside the container / host
VK_XRAY_HOST=127.0.0.1
VK_XRAY_PORT=54321
VK_XRAY_USERNAME=admin
VK_XRAY_PASSWORD=change_me_to_strong_password

# ==================== REALITY PROTOCOL ====================
# Run `python init_reality_config.py` to automatically fill these
# Or copy from 3x-ui panel: Inbounds -> Reality Inbound -> Keys

# Reality Public Key from panel
REALITY_PUBLIC_KEY=YOUR_REALITY_PUBLIC_KEY_HERE

# Reality Short ID from panel
REALITY_SHORT_ID=YOUR_REALITY_SHORT_ID_HERE

# Client TLS Fingerprint
REALITY_FINGERPRINT=chrome

# SNI for Reality handshake (disguise host, e.g. dl.google.com, yahoo.com)
REALITY_SNI=dl.google.com

# ==================== OUTBOUND CONFIGURATION ====================
# Forward double tunnel traffic from this bridge to the NL exit node
NL_SERVER_IP=YOUR_NL_SERVER_IP
NL_SERVER_PORT=443

# ==================== GENERAL ====================
LOG_LEVEL=info
TZ=UTC
