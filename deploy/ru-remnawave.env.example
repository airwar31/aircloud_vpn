# ==================== REMNAWAVE CORE CONFIGURATION ====================
APP_PORT=3000
METRICS_PORT=3001
API_INSTANCES=1

# ==================== DATABASE & CACHE ====================
DATABASE_URL=postgresql://postgres:postgres_password@remnawave-db:5432/postgres?schema=public&connection_limit=20&pool_timeout=60&queue_strategy=lifo
REDIS_SOCKET=/var/run/valkey/valkey.sock

# ==================== AUTH & SECURITY ====================
# Generate with: openssl rand -hex 32
JWT_AUTH_SECRET=generate_strong_random_secret_here
JWT_API_TOKENS_SECRET=generate_strong_random_secret_here

# ==================== TELEGRAM NOTIFICATIONS ====================
IS_TELEGRAM_NOTIFICATIONS_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_NOTIFY_USERS=
TELEGRAM_NOTIFY_NODES=
TELEGRAM_NOTIFY_CRM=
TELEGRAM_NOTIFY_SERVICE=
TELEGRAM_NOTIFY_TBLOCKER=

# ==================== DOMAINS & API ====================
PANEL_DOMAIN=panel.yourdomain.com
FRONT_END_DOMAIN=*
SUB_PUBLIC_DOMAIN=panel.yourdomain.com/api/sub
SWAGGER_PATH=/docs
SCALAR_PATH=/scalar
IS_DOCS_ENABLED=true

# ==================== METRICS & MONITORING ====================
METRICS_USER=rwmetrics
METRICS_PASS=change_me_to_strong_password

# ==================== WEBHOOKS ====================
WEBHOOK_ENABLED=false
WEBHOOK_URL=https://yourdomain.com/webhook
WEBHOOK_SECRET_HEADER=generate_strong_webhook_secret

# ==================== BANDWIDTH & USAGE ====================
BANDWIDTH_USAGE_NOTIFICATIONS_ENABLED=false
BANDWIDTH_USAGE_NOTIFICATIONS_THRESHOLD=[60,80]
NOT_CONNECTED_USERS_NOTIFICATIONS_ENABLED=false
NOT_CONNECTED_USERS_NOTIFICATIONS_AFTER_HOURS=[6,24,48]

# ==================== POSTGRES DOCKER SERVICE ====================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password
POSTGRES_DB=postgres
