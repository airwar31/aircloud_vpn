VK_XRAY_PORT=54321
VK_XRAY_USERNAME=admin
VK_XRAY_PASSWORD=admin123

# ==================== АВТОМАТИЧЕСКАЯ КОНФИГУРАЦИЯ TLS ====================
# ❌ НЕ ТРОГАЙТЕ ЭТИ ЗНАЧЕНИЯ - будут заполнены автоматически!
# 
# ИНСТРУКЦИИ ПО НАСТРОЙКЕ:
# ========================
# 1. Убедитесь, что 3xui панель запущена и настроена на NL сервере
# 2. Проверьте учетные данные выше (XRAY_HOST, XRAY_PORT, XRAY_USERNAME, XRAY_PASSWORD)
# 3. Запустите скрипт автоматической конфигурации:
#
#    python init_tls_config.py
#
# 4. Скрипт автоматически:
#    - Подключится к 3xui панели
#    - Получит конфигурацию TLS
#    - Заполнит значения ниже
#    - Обновит этот файл .env
#
# ЕСЛИ ВАМ НУЖНО ЗАПОЛНИТЬ ВРУЧНУЮ:
# ==================================
# 1. Откройте 3xui панель: http://XRAY_HOST:XRAY_PORT
# 2. Перейдите в меню "Inbounds" → выберите ваш TLS inbound
# 3. Посмотрите "Settings" и скопируйте значения
# 4. Или используйте API:
#    curl -u admin:password http://85.239.56.174:8443/api/inbounds/get/[INBOUND_ID]
#
#验证 КОНФИГУРАЦИИ:
# ==================
# curl -u admin:password http://85.239.56.174:8443/api/inbounds
# Найдите ваш TLS inbound и смотрите streamSettings.tlsSettings

# NL TLS Server parameters (заполнится автоматически скриптом)
NL_TLS_SERVER_NAME=example.com
NL_TLS_ALPN=h2,http/1.1
NL_TLS_CERTIFICATE_FILE=/path/to/cert.pem
NL_TLS_KEY_FILE=/path/to/key.pem

# ==================== REALITY КОНФИГУРАЦИЯ (с VK СЕРВЕРА) ====================
# ℹ️ Эти значения получаются со скрипта VK сервера (init_reality_config.py)
# 
# ИНСТРУКЦИИ:
# ===========
# 1. На VK сервере запустите:
#
#    cd deploy/vk-server
#    python init_reality_config.py
#
# 2. Скрипт покажет значения, скопируйте их сюда ИЛИ скрипт обновит .env автоматически
# 3. Или получите вручную из VK 3xui панели (смотрите VK .env.example для инструкций)

# Reality Protocol Configuration (с VK сервера)
REALITY_PUBLIC_KEY=PUBLIC_KEY_FROM_VK_SERVER
REALITY_SHORT_ID=SHORT_ID_FROM_VK_SERVER

# ==================== DATABASE ====================
DB_PATH=./data/users.db
DEBUG=False

# ==================== PAYMENT CONFIGURATION ====================
# YooKassa (Яндекс.Касса) - основной платежный метод
# Получите данные в личном кабинете: https://yookassa.ru/
YOOKASSA_ENABLED=True
YOOKASSA_SHOP_ID=your_shop_id_here
YOOKASSA_SECRET_KEY=your_secret_key_here
YOOKASSA_API_TIMEOUT=30
YOOKASSA_RETRIES=3

# Telegram Stars (звезды) - встроенная система Telegram
TELEGRAM_STARS_ENABLED=True
# Курс устанавливается Telegram, обычно 1 звезда = 1-2 рубля

# Криптовалюта (USDT, USDC, TON)
CRYPTO_ENABLED=True
CRYPTO_WALLET_ADDRESS=0x... # Ваш крипто-кошелек (Ethereum/BSC/TON)
CRYPTO_NETWORKS=ETH,TON,BSC # Поддерживаемые сети для оплаты

# ==================== LOGGING ====================
LOG_LEVEL=INFO
LOG_FILE=./logs/bot.log

# ==================== OPTIONAL SETTINGS ====================
# Webhook URL for bot (если используете webhooks вместо polling)
# WEBHOOK_URL=https://your-domain.com/webhook
# WEBHOOK_HOST=0.0.0.0
# WEBHOOK_PORT=8080

# Support group/channel link
SUPPORT_LINK=https://t.me/your_support_group
