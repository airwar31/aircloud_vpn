# ==================== AIRCLOUD VPN CONFIGURATION TEMPLATE ====================
# Copy this file to `deploy/nl-server/.env` before starting the service.

# ==================== TELEGRAM BOT ====================
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ_example
ADMIN_IDS=123456789
SUPPORT_LINK=https://t.me/your_support_username

# ==================== SERVER NETWORK ====================
# IP address of the main VPN node (Exit Server)
NL_SERVER_IP=198.51.100.1

# IP address of the bridge VPN node (Optional, Double Tunnel with Reality obfuscation)
VK_SERVER_IP=203.0.113.1

# ==================== 3X-UI PANEL (EXIT NODE) ====================
XRAY_HOST=xray-panel
XRAY_PORT=2053
XRAY_USERNAME=admin
XRAY_PASSWORD=change_me_to_strong_password
XUI_SYNC_CONTAINER=nl-xray-panel

# ==================== 3X-UI PANEL (BRIDGE NODE / VK) ====================
VK_XRAY_HOST=203.0.113.1
VK_XRAY_PORT=54321
VK_XRAY_USERNAME=admin
VK_XRAY_PASSWORD=change_me_to_strong_password

# ==================== INBOUND IDs ====================
NL_INBOUND_SINGLE_ID=1
NL_INBOUND_DOUBLE_ID=2
VK_INBOUND_REALITY_ID=1

# ==================== REALITY PROTOCOL CONFIGURATION ====================
NL_REALITY_PUBLIC_KEY=YOUR_NL_REALITY_PUBLIC_KEY
NL_REALITY_SHORT_ID=07577f03
NL_REALITY_SNI=dl.google.com

REALITY_PUBLIC_KEY=YOUR_BRIDGE_REALITY_PUBLIC_KEY
REALITY_SHORT_ID=6b
VK_REALITY_SNI=dl.google.com

# ==================== DATABASE ====================
DB_PATH=/app/db/users.db
DEBUG=False

# ==================== ENVIRONMENT & SECURITY ====================
APP_ENV=production
STRICT_CONFIG=true

# ==================== PAYMENTS: YOOKASSA ====================
YOOKASSA_ENABLED=True
YOOKASSA_SHOP_ID=1000000
YOOKASSA_SECRET_KEY=live_your_yookassa_secret_key_here
YOOKASSA_API_TIMEOUT=30
YOOKASSA_RETRIES=3
YOOKASSA_VALIDATE_SOURCE=True
YOOKASSA_TRUSTED_IPS=185.71.76.0/27,185.71.77.0/27,77.75.153.0/25,77.75.156.11,77.75.156.35

# ==================== PAYMENTS: TELEGRAM STARS ====================
TELEGRAM_STARS_ENABLED=True

# ==================== PAYMENTS: CRYPTOCURRENCY ====================
CRYPTO_ENABLED=False
CRYPTO_WALLET_ADDRESS=0x0000000000000000000000000000000000000000
CRYPTO_NETWORKS=ETH,TON,BSC

# ==================== WEB SERVICES & MINI APP ====================
SUBSCRIPTION_BASE_URL=https://vpn.yourdomain.com
MINI_APP_URL=https://vpn.yourdomain.com/app

# ==================== LOGGING ====================
LOG_LEVEL=INFO
LOG_FILE=./logs/bot.log

# ==================== PROVISIONER MODE ====================
PROVISIONER_MODE=legacy
READ_MODE=legacy
SHADOW_WRITE_ENABLED=False
CANARY_PERCENT=0

REMNAWAVE_API_URL=http://remnawave:3000
REMNAWAVE_API_TOKEN=your_remnawave_api_token
REMNAWAVE_TIMEOUT_SECONDS=20
REMNAWAVE_AUTH_MODE=bearer
REMNAWAVE_FALLBACK_TO_LEGACY=False
REMNAWAVE_SINGLE_SQUADS=
REMNAWAVE_DOUBLE_SQUADS=
