{
  "log": {
    "loglevel": "warning"
  },
  "inbounds": [
    {
      "port": 443,
      "protocol": "vless",
      "tag": "double-tunnel-in",
      "settings": {
        "clients": [
          {
            "id": "REPLACE_WITH_UUID_DOUBLE",
            "flow": "xtls-rprx-vision"
          }
        ],
        "decryption": "none"
      },
      "streamSettings": {
        "network": "tcp",
        "security": "reality",
        "realitySettings": {
          "show": false,
          "dest": "dl.google.com:443",
          "xver": 0,
          "serverNames": [
            "dl.google.com",
            "www.google.com"
          ],
          "privateKey": "REPLACE_WITH_PRIVATE_KEY",
          "minClientVer": "",
          "maxClientVer": "",
          "maxTimeDiff": 0,
          "shortIds": [
            "0123456789abcdef"
          ]
        }
      }
    }
  ],
  "outbounds": [
    {
      "protocol": "vless",
      "tag": "nl-tunnel",
      "settings": {
        "vnext": [
          {
            "address": "nl-server",
            "port": 443,
            "users": [
              {
                "id": "REPLACE_WITH_UUID_DOUBLE"
              }
            ]
          }
        ]
      },
      "streamSettings": {
        "network": "tcp",
        "security": "tls",
        "tlsSettings": {
          "serverName": "nl.vpn.example.com",
          "rejectUnknownSni": false
        }
      }
    }
  ],
  "routing": {
    "rules": [
      {
        "inboundTag": [
          "double-tunnel-in"
        ],
        "outboundTag": "nl-tunnel"
      }
    ]
  }
}
