FROM ubuntu:22.04

# Установка Python и системных зависимостей
RUN apt-get update && apt-get install -y \
    python3 \
    python3-pip \
    wget \
    unzip \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Создание символической ссылки для python
RUN ln -s /usr/bin/python3 /usr/bin/python

# Установка Xray
RUN wget -O xray.zip https://github.com/XTLS/Xray-core/releases/latest/download/Xray-linux-64.zip && \
    unzip xray.zip && \
    mv xray /usr/local/bin/ && \
    chmod +x /usr/local/bin/xray && \
    rm xray.zip

# Создание рабочей директории
WORKDIR /app

# Копирование файлов
COPY requirements-xray.txt requirements.txt
COPY xray_api.py .

# Установка Python зависимостей
RUN pip3 install --no-cache-dir -r requirements.txt

# Создание директории для конфигурации
RUN mkdir -p /etc/xray

# Переменные окружения
ENV SERVER_IP=YOUR_SERVER_IP
ENV FLASK_APP=xray_api.py

# Открытие портов
EXPOSE 8080 443

# Создание startup скрипта
RUN echo '#!/bin/bash\n# Запуск Flask API\npython3 xray_api.py &\n# Ожидание запуска API\nsleep 3\n# Запуск Xray\nif [ -f /etc/xray/config.json ]; then\n  /usr/local/bin/xray -config /etc/xray/config.json\nelse\n  echo "Config not found, waiting..."\n  sleep infinity\nfi' > /app/start.sh && chmod +x /app/start.sh

# Запуск
CMD ["/app/start.sh"]