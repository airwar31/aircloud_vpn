FROM python:3.9-slim

WORKDIR /app

COPY requirements-bot.txt requirements.txt
RUN pip install -r requirements.txt

COPY cleanup_expired.py .
COPY database.py .
COPY database_mysql.py .
COPY xray_manager.py .
COPY config.py .

# Создаем директорию для общей БД
RUN mkdir -p /shared

# Установка cron
RUN apt-get update && apt-get install -y cron && rm -rf /var/lib/apt/lists/*

# Создание лог файла
RUN touch /var/log/cleanup.log

# Создаем скрипт для запуска с переменными окружения
RUN echo '#!/bin/bash\ncd /app\nexport MYSQL_HOST="5.129.208.199"\nexport MYSQL_USER="gen_user"\nexport MYSQL_PASSWORD="1%)aD)Gz={E}+v"\nexport MYSQL_DATABASE="default_db"\nexport MYSQL_PORT="3306"\nexport XRAY_API_URL="http://xray-vpn:8080"\n/usr/local/bin/python cleanup_expired.py >> /var/log/cleanup.log 2>&1' > /app/cleanup_with_env.sh
RUN chmod +x /app/cleanup_with_env.sh

# Добавление задачи cron (каждые 10 минут)
RUN echo "*/10 * * * * /app/cleanup_with_env.sh" | crontab -

# Запуск cron и показ логов
CMD ["sh", "-c", "cron && /usr/local/bin/python cleanup_expired.py && tail -f /var/log/cleanup.log"]