FROM python:3.9-slim

WORKDIR /app

COPY requirements-bot.txt requirements.txt
RUN pip install -r requirements.txt

COPY cleanup_expired.py .
COPY database.py .
COPY database_mysql.py .
COPY xray_manager.py .
COPY config.py .

# Создаем директорию для общей БД
RUN mkdir -p /shared

# Установка cron
RUN apt-get update && apt-get install -y cron && rm -rf /var/lib/apt/lists/*

# Создание лог файла
RUN touch /var/log/cleanup.log

# Добавление задачи cron (каждые 10 минут)
RUN echo "*/10 * * * * cd /app && /usr/local/bin/python cleanup_expired.py >> /var/log/cleanup.log 2>&1" | crontab -

# Запуск cron и показ логов
CMD ["sh", "-c", "cron && /usr/local/bin/python cleanup_expired.py && tail -f /var/log/cleanup.log"]